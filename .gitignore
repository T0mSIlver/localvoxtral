.DS_Store
__pycache__/
/.build
/PolishHelper/.build
/SpeechHelper/.build
/Packages
xcuserdata/
DerivedData/
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.netrc
/dist
/.codex

# Local human-voice recordings for the agent-dictation eval. These can carry
# biometric voice data and are synced to the private Mac build host only.
/EvalRecordings/

# Machine-local scratch notes. `docs/` is TRACKED (AGENTS.md: committed
# user-facing docs live there); `/docs` was ignored here from the first
# release, before that split existed, which silently swallowed the first
# committed docs page.
/local-notes/

# Agent runtime dirs (opencode/Claude workers) — never commit
.agent-runs/
.opencode/

# Transient enable markers written by remote-build.sh eval-llm /
# integration-polishd / integration-speechd / eval-e2e / dogfood
/.llm-polish-eval-enable.json
/.polishd-integration-enable.json
/.speechd-integration-enable.json
/.agent-eval-e2e-enable.json
# Compile gate for the dogfooding context capture (Package.swift reads it).
# Never commit: its presence changes what the app is compiled to do.
/.dogfood-capture-enable
.fastcontext/
